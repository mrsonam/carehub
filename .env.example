# Postgres (Prisma). Use Supabase "Transaction" pooler (port 6543) for DATABASE_URL in
# serverless so many app instances share a small server-side pool. Use direct (5432) for DIRECT_URL.
DATABASE_URL=postgresql://...
DIRECT_URL=postgresql://...

# Optional: max connections per Node process (default 1 on Vercel/Lambda, 10 locally).
# DATABASE_POOL_MAX=5

STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
PAYMENT_CURRENCY=aud

# Supabase Storage (profile photos)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
