# =============================================================================
# CareHub environment template — copy to .env and fill in values.
# Full setup guide: docs/installation/INSTALLATION.md
# =============================================================================

# --- Required: PostgreSQL (Prisma) ---
# Use Supabase "Transaction" pooler (port 6543) for DATABASE_URL in serverless.
# Use direct/session connection (port 5432) for DIRECT_URL (migrations & seed).
DATABASE_URL=postgresql://...
DIRECT_URL=postgresql://...

# Optional: max connections per Node process (default 1 on Vercel/Lambda, 10 locally).
# DATABASE_POOL_MAX=5

# --- Required: authentication (session JWT signing) ---
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=

# --- Optional: public app URL (recommended in production) ---
# NEXT_PUBLIC_APP_URL=https://your-clinic.example.com

# --- Optional: Stripe (appointment payments) ---
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
PAYMENT_CURRENCY=aud

# --- Optional: Supabase Storage (profile photos) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Optional: Resend (contact form & staff welcome email) ---
RESEND_API_KEY=re_...
EMAIL_FROM=onboarding@resend.dev
CONTACT_INBOX_EMAIL=clinic-inbox@yourcompany.com

# --- Optional: NVIDIA API (public site chatbot) ---
# NVIDIA_API_KEY=nvapi-...
# NVIDIA_API_BASE_URL=https://integrate.api.nvidia.com/v1
# CHATBOT_MODEL=minimaxai/minimax-m2.7

# --- Optional: production cron (appointment reminders) ---
# CRON_SECRET=generate_a_long_random_string
